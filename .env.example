# Application
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3001

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_garbage_manual_db

# Generate a long random secret; never commit the real value.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional integrations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
RESEND_API_KEY=
# Use onboarding@resend.dev for local testing, or a sender on your verified domain in production.
RESEND_FROM_EMAIL=Smart Garbage <onboarding@resend.dev>

# Reference/development data
DEFAULT_BARANGAY_NAME=Bang-bang
DEFAULT_PUROK_COUNT=5
SEED_DEMO_DATA=false

# Required only while running: npm run create-super-admin
SUPER_ADMIN_NAME=Municipal System Administrator
SUPER_ADMIN_EMAIL=superadmin@example.gov.ph
SUPER_ADMIN_RECOVERY_EMAIL=recovery@example.com
SUPER_ADMIN_TEMP_PASSWORD=Replace-With-A-Strong-Temporary-Password1!
