# Application
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3001

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_garbage_manual_db

# Security
JWT_SECRET=replace-with-a-long-random-secret

# Private payment-proof storage (server only)
# Leave these blank for local-only development; proofs then remain in MySQL.
SUPABASE_URL=
# Use the Secret key from Settings > API Keys. The legacy service_role key is
# also accepted for older Supabase projects.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=payment-proofs
SUPABASE_STORAGE_SIGNED_URL_TTL=3600

# Gemini / Chatbot (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Google Login (optional)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Email / Password Reset
RESEND_API_KEY=
RESEND_FROM_EMAIL=Smart Garbage <onboarding@resend.dev>

# Initial / Development Data
DEFAULT_BARANGAY_NAME=Bang-bang
DEFAULT_PUROK_COUNT=5
SEED_DEMO_DATA=false

# Only needed when creating the Municipal Admin account
SUPER_ADMIN_NAME=Municipal System Administrator
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_RECOVERY_EMAIL=
SUPER_ADMIN_TEMP_PASSWORD=
