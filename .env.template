# Application environment template
PORT=3001
NODE_ENV=development
# In production, use the exact HTTPS origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3001
# Set true when the app is behind a reverse proxy/load balancer.
TRUST_PROXY=false

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_garbage_manual_db

# Security
JWT_SECRET=7b61bcca634237def388a60d0ed121ee5d09f325724a87a081f2a493d7052205
# Private payment-proof storage (server only)
# Leave both blank for local-only development; proofs then remain in MySQL.
SUPABASE_URL=
# Use the Secret key from Settings > API Keys. The legacy service_role key is
# also accepted for older Supabase projects.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=payment-proofs
SUPABASE_STORAGE_SIGNED_URL_TTL=3600

# Gemini / Chatbot (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Google Login (optional)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Email verification for all new accounts / Password Reset (server only)
RESEND_API_KEY=
# Required: set the sender to an address on your verified Resend domain.
# EMAIL_FROM is also accepted when RESEND_FROM_EMAIL is unset.
RESEND_FROM_EMAIL=

# Initial barangay setup (required by npm run db:setup)
DEFAULT_BARANGAY_NAME=Bang-bang
DEFAULT_PUROK_COUNT=5

# Only needed when creating the Municipal Admin account
# Only needed when creating the Municipal Admin account
SUPER_ADMIN_NAME=Municipal System Administrator
SUPER_ADMIN_EMAIL=superadmin@cordova.gov.ph
SUPER_ADMIN_RECOVERY_EMAIL=menro@cordova.gov.ph
SUPER_ADMIN_TEMP_PASSWORD=ChangeMe123!

# Payment rates (server; restart after changing)
PAYMENT_WEEKLY_FEE=5
PAYMENT_HEAVY_TRASH_FEE=80
PAYMENT_HAZARDOUS_FEE=120

# Initial map center (public; rebuild after changing)
VITE_MAP_CENTER_LAT=10.2525
VITE_MAP_CENTER_LNG=123.9494
