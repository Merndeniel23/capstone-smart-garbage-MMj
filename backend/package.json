{
  "name": "@sgms/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild ./server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test:registration": "tsx --test services/emailDomain.test.ts services/pendingRegistration.test.ts",
    "test:accounts": "tsx --test services/accountDeletion.test.ts",
    "test:notifications": "tsx --test routes/notifications.test.ts",
    "test:schedules": "tsx --test routes/collectionSchedules.test.ts",
    "db:setup": "tsx scripts/setupDatabase.ts",
    "create-super-admin": "tsx scripts/bootstrapSuperAdmin.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.112.4",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.23.1",
    "nodemailer": "^9.0.3",
    "resend": "^6.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
