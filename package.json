{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "sgms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace @sgms/frontend",
    "dev:backend": "npm run dev --workspace @sgms/backend",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace @sgms/frontend",
    "build:backend": "npm run build --workspace @sgms/backend",
    "start": "npm run start:backend",
    "start:backend": "npm run start --workspace @sgms/backend",
    "preview": "npm run preview --workspace @sgms/frontend",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:registration": "npm run test:registration --workspace @sgms/backend",
    "test:accounts": "npm run test:accounts --workspace @sgms/backend",
    "test:notifications": "npm run test:notifications --workspace @sgms/backend",
    "test:schedules": "npm run test:schedules --workspace @sgms/backend",
    "test:xendit": "npm run test:xendit --workspace @sgms/backend",
    "db:setup": "npm run db:setup --workspace @sgms/backend",
    "create-super-admin": "npm run create-super-admin --workspace @sgms/backend"
  }
}
